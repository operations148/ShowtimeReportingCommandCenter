# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Reporting Command Center Configuration
REPORTING_DATA_SOURCE=live
REPORTING_CACHE_TTL_SECONDS=300
REPORTING_ENABLE_MOCK_FALLBACK=true

# Security and Application Access
AUTH_SECRET="ENTER_SECURE_AUTH_PASSPHRASE_RANDOM_HASH"
APP_URL="https://your-reporting-app.vercel.app"

# --- Supabase (REQUIRED — this is the authentication backend) --------------------------
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are both required for login, /api/auth/me, and
# every tenant/workspace query. Missing or mismatched values here are the single most common
# cause of production login outages in this project's history.
#
#   - Both values MUST come from the SAME Supabase project (Project Settings -> API).
#     A URL from one project paired with a key from another fails in ways that look like a
#     network problem, not a mismatch.
#   - SUPABASE_SERVICE_ROLE_KEY is SERVER-ONLY. It bypasses Row Level Security. It must
#     NEVER be prefixed with VITE_ (or any prefix that exposes it to the client bundle) —
#     doing so would ship full database access to every visitor's browser.
#   - When pasting into the Vercel dashboard or `vercel env add`, paste the raw value only:
#     no surrounding quotes, no leading/trailing whitespace, and verify the source did not
#     inject a UTF-8 byte-order mark (BOM). A BOM-prefixed SUPABASE_URL parses as an invalid
#     URL and causes every login to fail as an opaque "fetch failed" — this has happened
#     more than once via PowerShell tools that write UTF-8 files with a BOM by default.
#   - Set this in both the Production AND Preview scopes in Vercel if you want Preview
#     deployments to authenticate; a var set only in Production will leave Preview logins
#     failing with the same "fetch failed" symptom.
#   - A Vercel environment-variable change does NOT affect an already-running deployment.
#     A new deployment must be triggered after any change here.
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="<paste-your-supabase-service-role-key-here>"

# Direct Postgres connection, used only by scripts/migrate.mjs and other local/CI tooling
# that runs SQL migrations. NOT read by the deployed API (which uses the Supabase client
# above). Use the Session Pooler URI (IPv4) from Supabase -> Project Settings -> Database —
# the direct db.<ref>.supabase.co host is IPv6-only and unreachable from many networks.
DATABASE_URL="postgresql://postgres.your-project-ref:PASSWORD@aws-1-region.pooler.supabase.com:5432/postgres"

# --- Task Management feature flags (BOTH DEFAULT TO DISABLED) --------------------------
# The Task Management module is inert unless explicitly enabled. Deploying the code without
# setting these leaves the feature completely unavailable, which is the intended default.
#
#   - Enforced SERVER-SIDE in the task router, before any authorization or data access.
#     A client-side visibility flag is a UX affordance only and is NOT a security boundary:
#     hiding a nav item does not stop anyone calling /api/tasks directly.
#   - Anything other than an explicit truthy value ("true", "1", "yes", "on") is false.
#   - TASK_TIME_TRACKING_ENABLED additionally requires TASK_MANAGEMENT_ENABLED; the time
#     engine cannot be switched on while the module itself is off.
#   - TASK_CHANNELS_ENABLED likewise requires TASK_MANAGEMENT_ENABLED. It gates the workspace
#     messaging subsystem (/api/tasks/channels/*) independently, so messaging can be piloted
#     or withdrawn without touching the task hierarchy. With it off, every channel route
#     refuses with TASK_CHANNELS_DISABLED before touching the database.
#   - Set per environment in Vercel. Do NOT enable in Production until the module has been
#     verified in Preview.
TASK_MANAGEMENT_ENABLED=false
TASK_TIME_TRACKING_ENABLED=false
TASK_CHANNELS_ENABLED=false

# Staged rollout gate. Sits BETWEEN the master flag above and the entitlement policy: the
# master flag says whether this deployment runs the module at all, this says which workspaces
# may use it yet.
#
#   off    - closed. Nothing new may be created, read or changed. (default)
#   canary - only the workspace ids listed below.
#   all    - every workspace, subject to the normal entitlement and RBAC rules. Reserved for
#            the approved production release.
#
# FAILS CLOSED. A missing, blank, mis-typed or unrecognised mode resolves to `off`, and
# `canary` with an empty or unparseable allowlist admits nobody. A typo here must never be
# the thing that exposes an unreleased module to a live tenant.
#
# Stopping and recovering an ALREADY-RUNNING timer stays permitted even for a workspace that
# has left the rollout, so a controlled shutdown cannot strand a timer that would otherwise
# accrue forever.
TASK_MANAGEMENT_ROLLOUT_MODE=off

# Comma-separated workspace ids admitted while the mode is `canary`. Matching is exact and
# case-sensitive; blanks and stray whitespace are ignored rather than treated as an entry.
TASK_MANAGEMENT_CANARY_WORKSPACE_IDS=

# Client-side visibility for the Task Management nav tab. NOT a security boundary — it only
# decides whether the tab renders. The API is protected independently by the SERVER flags
# above, so forcing these true in a browser still yields 403 TASK_MODULE_DISABLED or
# 403 TASK_ROLLOUT_EXCLUDED from every /api/tasks call. Vite inlines VITE_* at BUILD time and
# they are readable in the shipped bundle, so never put a secret behind a VITE_ prefix.
VITE_TASK_MANAGEMENT_ENABLED=false

# Client-side mirror of the canary allowlist, so a Preview build does not dangle the tab in
# front of a tenant whose API calls would only be refused. Leave empty for a full release.
# Workspace ids are not secrets — the signed-in user already knows their own.
VITE_TASK_MANAGEMENT_CANARY_WORKSPACE_IDS=

# GoHighLevel Private Token credentials (V2 API)
GHL_AUTH_MODE=private_token
GHL_PRIVATE_INTEGRATION_TOKEN=your_ghl_private_integration_token_here
GHL_LOCATION_ID=your_ghl_location_id_here
GHL_COMPANY_ID=
GHL_API_VERSION=2021-07-28
GHL_BASE_URL=https://services.leadconnectorhq.com

# GoHighLevel Multi-Location OAuth Integration (For Scaling)
GHL_CLIENT_ID=
GHL_CLIENT_SECRET=
GHL_REDIRECT_URI=
GHL_REFRESH_TOKEN=

# Stripe Billing & Subscription Infrastructure
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

